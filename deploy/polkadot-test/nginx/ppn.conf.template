# Product Preview Network - nginx configuration
# WebSocket reverse proxy for all zombienet endpoints
#
# NOTE: This is a template. The actual config is generated during deployment
# by running: envsubst < ppn.conf.template > ppn.conf
# Port values come from config/ports.env

# Upstream definitions for all WebSocket endpoints
# Chain routes are generated by `ppn nginx-conf` from the network descriptor — the same
# table the dashboard serves. Add a parachain to networks/<name>.json and the next deploy
# routes it; nothing here to edit. Service blocks below stay hand-written: they carry
# bespoke CORS/body-size/header behaviour that is not mere routing.
# {{GENERATED_UPSTREAMS}}

upstream eth_rpc {
    server 127.0.0.1:${ETH_RPC_PORT};
    keepalive 32;
}

upstream storage_provider {
    server 127.0.0.1:${WEB3_STORAGE_PROVIDER_PORT};
    keepalive 32;
}

# The identity backend. Deliberately a single upstream: several services own slices of
# /api/v1/* — identity-api and username-indexer even split /api/v1/usernames by method — and
# that split is owned upstream, now by the route table compiled into `ibv2 --role all-in-one`.
# nginx must not learn it, or every ownership change upstream becomes an nginx change here.
upstream dub {
    server 127.0.0.1:${DUB_PORT};
    keepalive 32;
}

upstream ipfs_gateway {
    server 127.0.0.1:${IPFS_GATEWAY_PORT};
    keepalive 32;
}

# WebSocket upgrade mapping
map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# HTTP server - redirect to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name ${PPN_DOMAIN};

    # Certbot ACME challenge location (for certificate renewals)
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    # Redirect all other traffic to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS server - main configuration
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name ${PPN_DOMAIN};

    # Certificate directory, chosen by redeploy.sh: certbot's live path when a real
    # certificate exists, otherwise the self-signed stopgap under /etc/ppn/tls.
    ssl_certificate ${PPN_TLS_DIR}/fullchain.pem;
    ssl_certificate_key ${PPN_TLS_DIR}/privkey.pem;

    # SSL settings (modern configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

        # {{GENERATED_LOCATIONS}}

    # Ethereum RPC (eth-rpc connected to Asset Hub)
    location /eth-rpc {
        proxy_pass http://eth_rpc/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:${ETH_RPC_PORT};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS headers for JSON-RPC
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type" always;

        # Handle preflight requests
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Identity backend (auth, username registration, search, /docs API reference)
    location /dub/ {
        proxy_pass http://dub/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:${DUB_PORT};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Content-Type, Authorization" always;

        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # Web3 Storage Provider Node (HTTP API: /health, /stats, agreements)
    location /web3-storage-provider/ {
        proxy_pass http://storage_provider/;
        proxy_http_version 1.1;
        proxy_set_header Host 127.0.0.1:${WEB3_STORAGE_PROVIDER_PORT};
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Allow large file uploads (nginx defaults to 1m, which 413s anything bigger).
        client_max_body_size 256m;

        # CORS headers for HTTP API. Strip the provider node's own
        # Access-Control-Allow-Origin first (it ships with CorsLayer::permissive),
        # otherwise browsers see "*, *" and reject the response — same trick the
        # IPFS block below uses for Kubo.
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin * always;
        # Web3 Storage uploads use PUT/DELETE/HEAD and send an Authorization header,
        # so the preflight must whitelist them (browsers reject otherwise).
        add_header Access-Control-Allow-Methods "GET, POST, PUT, DELETE, HEAD, OPTIONS" always;
        add_header Access-Control-Allow-Headers "Authorization, Content-Type" always;

        # Handle preflight requests
        if ($request_method = OPTIONS) {
            return 204;
        }
    }

    # IPFS Gateway
    location /ipfs/ {
        proxy_pass http://ipfs_gateway/ipfs/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Increase timeouts for large files
        proxy_read_timeout 300;
        proxy_connect_timeout 60;

        # Strip Kubo's Access-Control-Allow-Origin before adding our own,
        # otherwise browsers see "*, *" and reject the response.
        proxy_hide_header Access-Control-Allow-Origin;
        add_header Access-Control-Allow-Origin * always;
    }

    # Chain specifications - for smoldot light clients, and for `make bite`
    # against this deployment (specSource: "published" in networks/*.json).
    # Serve any top-level raw chainspec JSON (not -plain, not zombie.json, not
    # subdirs). Spec names follow the network's chain ids — previewnet's end in
    # -local, a fork of a public network carries the source's ids — so the name
    # set cannot be enumerated here.
    location ~ "^/chainspecs/((?!zombie\.json$)[a-z0-9-]+(?<!-plain))\.json$" {
        alias ${DATA_DIR}/$1.json;

        default_type application/json;

        # Add CORS headers for chainspec access
        add_header Access-Control-Allow-Origin * always;
        add_header Access-Control-Allow-Methods "GET, OPTIONS" always;
        add_header Content-Disposition 'attachment' always;
    }

    # Log viewer endpoint - serves log files organized by date
    location /logs/ {
        alias ${LOG_DIR}/;
        index index.html;
        autoindex on;
        autoindex_format html;

        # MIME types: log files as plain text, html for index pages
        types {
            text/plain log;
            text/html html;
        }
        default_type text/plain;

        # Add CORS headers for log access
        add_header Access-Control-Allow-Origin *;
    }

    # Health check endpoint - simple static response
    location /health {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"ok","service":"ppn"}';
    }

    # Root — the dashboard (UI, /api, log streams). It replaced the static landing page:
    # same information, but rendered live from the network instead of hand-maintained HTML.
    location / {
        proxy_pass http://127.0.0.1:${DASHBOARD_PORT};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # SSE log streams die behind buffering.
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}

# P2P WSS ports for in-browser light clients
#
# The P2P ports speak WS, which browsers refuse to dial from an HTTPS page.
# nginx terminates TLS on a chain's P2P WSS port and proxies to that chain's
# P2P WS port, selected by the port the request arrived on.
map $server_port $p2p_port {
    ${RELAY_ALICE_P2P_WSS_PORT} ${RELAY_ALICE_P2P_PORT};
    ${ASSET_HUB_P2P_WSS_PORT} ${ASSET_HUB_P2P_PORT};
    ${PEOPLE_P2P_WSS_PORT} ${PEOPLE_P2P_PORT};
    ${BULLETIN_P2P_WSS_PORT} ${BULLETIN_P2P_PORT};
    ${WEB3_STORAGE_P2P_WSS_PORT} ${WEB3_STORAGE_P2P_PORT};
}

server {
    listen ${RELAY_ALICE_P2P_WSS_PORT} ssl;
    listen [::]:${RELAY_ALICE_P2P_WSS_PORT} ssl;
    listen ${ASSET_HUB_P2P_WSS_PORT} ssl;
    listen [::]:${ASSET_HUB_P2P_WSS_PORT} ssl;
    listen ${PEOPLE_P2P_WSS_PORT} ssl;
    listen [::]:${PEOPLE_P2P_WSS_PORT} ssl;
    listen ${BULLETIN_P2P_WSS_PORT} ssl;
    listen [::]:${BULLETIN_P2P_WSS_PORT} ssl;
    listen ${WEB3_STORAGE_P2P_WSS_PORT} ssl;
    listen [::]:${WEB3_STORAGE_P2P_WSS_PORT} ssl;
    server_name ${PPN_DOMAIN};

    # Certificate directory, chosen by redeploy.sh: certbot's live path when a real
    # certificate exists, otherwise the self-signed stopgap under /etc/ppn/tls.
    ssl_certificate ${PPN_TLS_DIR}/fullchain.pem;
    ssl_certificate_key ${PPN_TLS_DIR}/privkey.pem;

    # SSL settings (modern configuration)
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location / {
        proxy_pass http://127.0.0.1:$p2p_port;
        include /etc/nginx/snippets/websocket-proxy.conf;
    }
}
