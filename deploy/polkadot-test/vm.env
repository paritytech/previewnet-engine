# The one machine this branch is for. Committed: nothing here is secret.
# Secrets (the dashboard actions token) live in local.env next to this file, gitignored;
# apply.sh creates it on first run.
NETWORK=polkadot
DOMAIN=polkadot-test.substrate.dev
PUBLIC_IP=62.210.172.32
# The unix user the network runs as (systemd User=, owner of the checkout).
RUN_USER=ubuntu
# Extra flags for `ppn start polkadot --fork` in the systemd unit. Empty resumes the fork on
# its own data; `--clean` puts it back at the bite block on every start.
START_FLAGS=
LOG_DIR=/var/log/ppn
