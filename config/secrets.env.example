# Every key a server's secrets file (PPN_SECRETS_FILE) may hold. `ppn secrets check <file>`
# fails when a required key is missing or empty, or when the file holds a key not listed here.
# A key the engine starts reading is added here, or no deployment knows to supply it.

# ---- always ----

# local: the dev accounts are sudo and funded. deployable: the keys below are.
PPN_PROFILE=
# Identity backend's token signing seed: echo 0x$(openssl rand -hex 32)
JWT_ED25519_SECRET=
# TURN relay password, shared with the backend: openssl rand -hex 24 | tr -d '\n' | base64
TURN_SECRET=

# ---- deployable ----

# Sudo account key: echo 0x$(openssl rand -hex 32)
PPN_SUDO_URI=
# Sudo account address: subkey inspect "$PPN_SUDO_URI" --output-type json | jq -r .ss58Address
PPN_SUDO_SS58=
# Faucet account address; its key lives with the faucet.
PPN_FAUCET_SS58=
# Identity backend's chain writer key: echo 0x$(openssl rand -hex 32)
PPN_DUB_ATTESTER_URI=
# Its address, which gets the attestation allowance: subkey inspect "$PPN_DUB_ATTESTER_URI" --output-type json | jq -r .ss58Address
PPN_ALLOWANCE_SS58=

# ---- optional ----

# Invite ticket signer key, instead of //Bob: echo 0x$(openssl rand -hex 32)
PPN_INVITER_SURI=
# Its address: subkey inspect "$PPN_INVITER_SURI" --output-type json | jq -r .ss58Address
PPN_INVITER_SS58=
# Apple push notifications, read by the identity backend.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
APNS_ENVIRONMENT=
APNS_PRIVATE_KEY=
APNS_PRIVATE_KEY_FILE=
# Android push notifications, read by the identity backend.
FCM_SERVICE_ACCOUNT_JSON=
