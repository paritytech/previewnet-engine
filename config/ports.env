# config/ports.env - Port configuration for PPN
# Update this file when adding/removing validators or chains
# Run scripts/validate-ports.sh to verify consistency with toml-generator

# Relay chain validator RPC ports
RELAY_ALICE_PORT=10000
RELAY_BOB_PORT=10001
RELAY_CHARLIE_PORT=10002
RELAY_DAVE_PORT=10003
RELAY_EVE_PORT=10004
RELAY_FERDIE_PORT=10005

# Parachain collator RPC ports
PEOPLE_PORT=10010
ASSET_HUB_PORT=10020
BULLETIN_PORT=10030
WEB3_STORAGE_PORT=10040

# Parachain IDs are NOT here: they belong to the network, not the machine, and two
# networks use different ones (previewnet 1500+, devnet 1000+). Each chain declares
# its own in networks/<name>.json — see networks/README.md. This file holds only what
# is local: which port each chain listens on.

# P2P ports (must be reachable for external nodes to connect)
RELAY_ALICE_P2P_PORT=30334
ASSET_HUB_P2P_PORT=30335
PEOPLE_P2P_PORT=30336
BULLETIN_P2P_PORT=30333
WEB3_STORAGE_P2P_PORT=30337

# P2P WSS ports (must be reachable for in-browser light clients to connect)
#
# nginx terminates TLS on these and proxies to the P2P WS ports above.
# Each is the matching P2P WS port + 1000.
RELAY_ALICE_P2P_WSS_PORT=31334
ASSET_HUB_P2P_WSS_PORT=31335
PEOPLE_P2P_WSS_PORT=31336
BULLETIN_P2P_WSS_PORT=31333
WEB3_STORAGE_P2P_WSS_PORT=31337

# Bootnode hostname (127.0.0.1 for local; a deployment overrides it)
BOOTNODE_HOSTNAME=127.0.0.1

# Interface the webrtc-direct collators bind (asset-hub, bulletin, web3-storage). Loopback
# locally; a server sets its public IP, or exports P2P_LISTEN_IP, which wins over this file.
# webrtc-direct advertises what it binds, so a 127.0.0.1 listener is reachable by nobody else.
P2P_LISTEN_IP=127.0.0.1

# Storage-provider data dir (disk mode). Empty locally so the wrapper derives it
# from DATA_DIR; a deployment patches this to an absolute path under the
# persistent DATA_DIR, because zombie-cli does not forward env vars to
# custom_processes (same reason BOOTNODE_HOSTNAME is patched here).
WEB3_STORAGE_PROVIDER_DATA_DIR=

# Storage-provider storage mode: "disk" (persistent) or "inmemory" (ephemeral).
# Defaults to disk. zombie-cli does not forward env vars to custom_processes, so
# EPHEMERAL cannot reach the wrapper directly; for native runs `make start`
# regenerates config/ports.local.env (sourced after this file) to flip the mode
# to inmemory under EPHEMERAL=1. The server stays on the disk default.
WEB3_STORAGE_PROVIDER_STORAGE_MODE=disk

# Auxiliary service ports (defaults from binaries)
ETH_RPC_PORT=8545

# eth-rpc's receipt/index cache. Empty locally so the wrapper derives it from
# DATA_DIR (as $DATA_DIR/eth-rpc-db — NOT eth-rpc, which is where zombienet
# writes that process's log); a deployment patches this to an absolute
# path under the persistent DATA_DIR, for the same reason
# WEB3_STORAGE_PROVIDER_DATA_DIR above is patched (zombie-cli does not forward
# env vars to custom_processes). The cache must share the chain data's lifetime:
# a cache left over from a wiped chain makes eth-rpc exit with ChainMismatch.
ETH_RPC_DATA_DIR=
IPFS_GATEWAY_PORT=8080
IPFS_API_PORT=5001
IPFS_SWARM_PORT=4001
WEB3_STORAGE_PROVIDER_PORT=3333

# Identity backend ports (see docs/DEVICE-UNIQUENESS-BACKEND.md)
#
# Kept out of the 10000-10040 band on purpose: that band is node RPC ports, one
# per chain, and anything adjacent to it reads as "the next parachain". These
# sit with the other auxiliary HTTP services instead, and Postgres keeps its own
# well-known number (offset by one so it does not fight a developer's system
# Postgres on 5432).
#
# Deliberately absent from ALL_PORTS below: that list is compared against the
# TOML's rpc_port entries by scripts/validate-ports.sh, and these are plain
# services, not nodes.
DUB_POSTGRES_PORT=5433

# The device-uniqueness backend's single origin: every HTTP surface, on one port. Backend v0.2.0
# ships one binary whose `all-in-one` role merges the six HTTP services behind the route
# table it compiles in, which is why there is one port here and not one per service — and
# why PPN no longer runs a gateway of its own to reassemble them.
DUB_PORT=8092
# The dashboard: the network's own status UI and API (docs/DASHBOARD.md)
DASHBOARD_PORT=8090

# What the dashboard advertises as the public address of every chain and service. Empty
# locally, so it falls back to http://127.0.0.1:$DASHBOARD_PORT; a deployment patches it to
# its own public URL. It has to be set here rather than in the environment, because zombienet
# hands the dashboard, a custom process, no environment at all. Without it a server behind a
# reverse proxy tells every browser to connect to 127.0.0.1.
PPN_PUBLIC_URL=

# Where the dashboard binds. Loopback by default, which is also what leaves the sudo action
# plane open (see docs/DASHBOARD.md): widen this and actions need DASHBOARD_ACTIONS_TOKEN.
DASHBOARD_HOST=

# The bearer token for the sudo action plane when the dashboard is bound beyond loopback.
# Empty means the dashboard is read-only there.
DASHBOARD_ACTIONS_TOKEN=

# The file holding this deployment's secrets: PPN_PROFILE, the sudo, faucet, allowance and
# attester keys. Empty means the local profile and the dev keys.
#
# It lives here rather than only in the environment because every service that needs those
# keys runs as a zombienet custom process, and those are handed no environment at all. Setting
# it for the supervisor reaches the supervisor and stops; a deployment patches this file.
PPN_SECRETS_FILE=

# Where this run's chain state and per-process logs live. Empty locally: `ppn start`
# resolves it per mode (data/ vs data-fork/) and writes the answer to
# config/ports.local.env, which is sourced after this file. A deployment that spawns
# zombie-cli directly never runs `ppn start`, so nothing writes it there and the dashboard
# falls back to <release>/data, an empty directory: no logs, no spawn stamp, no chain-spec
# downloads. A deployment patches this to its persistent DATA_DIR, for the same reason the
# three paths above are patched (zombie-cli does not forward env vars to custom_processes).
PPN_DATA_DIR=

# Postgres cluster directory. Empty locally so the wrapper derives it from
# DATA_DIR (as $DATA_DIR/identity-pgdata — NOT $DATA_DIR/dub-postgres, which is
# where zombienet writes that process's log, and initdb refuses a non-empty dir).
#
# The directory keeps the name identity-pgdata deliberately: renaming a state path
# orphans the cluster already on a deployed server, which would silently reinitialise
# an empty one. A name is not worth someone's data.
# a deployment patches this to an absolute path under the persistent
# DATA_DIR, for the same reason WEB3_STORAGE_PROVIDER_DATA_DIR above is patched
# (zombie-cli does not forward env vars to custom_processes).
DUB_POSTGRES_DATA_DIR=


# Aggregate lists
RELAY_PORTS="$RELAY_ALICE_PORT $RELAY_BOB_PORT $RELAY_CHARLIE_PORT $RELAY_DAVE_PORT $RELAY_EVE_PORT $RELAY_FERDIE_PORT"
PARACHAIN_PORTS="$PEOPLE_PORT $ASSET_HUB_PORT $BULLETIN_PORT $WEB3_STORAGE_PORT"
ALL_PORTS="$RELAY_PORTS $PARACHAIN_PORTS"
