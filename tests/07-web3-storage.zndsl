Description: Web3 Storage Chain - Smoke Tests
Network: ../zombienet-configs/local-dev.toml
Creds: config

# ============================================
# Prerequisites
# ============================================

# Collator must be up
web3-storage-collator1: is up

# Parachain must be registered and producing blocks
alice-paseo-validator: parachain 1600 is registered within 400 seconds
alice-paseo-validator: parachain 1600 block height is at least 5 within 500 seconds
