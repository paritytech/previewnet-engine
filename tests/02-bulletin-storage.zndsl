Description: Bulletin Chain - Transaction Storage Tests
Network: ../zombienet-configs/local-dev.toml
Creds: config

# ============================================
# Prerequisites
# ============================================

# Collator must be up
bulletin-collator1: is up

# Parachain must be registered and producing blocks
alice-paseo-validator: parachain 1501 is registered within 400 seconds
alice-paseo-validator: parachain 1501 block height is at least 5 within 500 seconds

# ============================================
# transactionStorage Pallet Tests
# ============================================

# Custom JS script to verify transactionStorage pallet
bulletin-collator1: js-script ./scripts/dist/test-bulletin-storage.js return is equal to 1 within 600 seconds
