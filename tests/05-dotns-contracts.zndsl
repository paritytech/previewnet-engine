Description: Asset Hub - DotNS Smart Contract Verification
Network: ../zombienet-configs/local-dev.toml
Creds: config

# ============================================
# Prerequisites
# ============================================

# Collator must be up
asset-hub-collator1: is up

# Parachain must be registered and producing blocks
alice-paseo-validator: parachain 1500 is registered within 400 seconds
alice-paseo-validator: parachain 1500 block height is at least 5 within 500 seconds

# ============================================
# DotNS Contract Tests
# ============================================

# Verify all DotNS contracts are deployed at genesis via eth-rpc
asset-hub-collator1: js-script ./scripts/dist/test-dotns-contracts.js return is equal to 1 within 600 seconds
