Description: Asset Hub - pallet-revive Smart Contract Tests
Network: ../zombienet-configs/local-dev.toml
Creds: config

# ============================================
# Prerequisites
# ============================================

# Collator must be up
asset-hub-collator1: is up

# Parachain must be registered and producing blocks
alice-paseo-validator: parachain 1500 is registered within 400 seconds
alice-paseo-validator: parachain 1500 block height is at least 5 within 500 seconds

# ============================================
# pallet-revive Tests
# ============================================

# Custom JS script to verify pallet-revive functionality
asset-hub-collator1: js-script ./scripts/dist/test-asset-hub-revive.js return is equal to 1 within 600 seconds
