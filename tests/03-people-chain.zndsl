Description: People Chain - Individuality Pallet Tests
Network: ../zombienet-configs/local-dev.toml
Creds: config

# ============================================
# Prerequisites
# ============================================

# Collator must be up
people-collator1: is up

# Parachain must be registered and producing blocks
alice-paseo-validator: parachain 1502 is registered within 400 seconds
alice-paseo-validator: parachain 1502 block height is at least 5 within 500 seconds

# ============================================
# Individuality Pallet Tests
# ============================================

# Custom JS script to verify individuality pallets
people-collator1: js-script ./scripts/dist/test-people-chain.js return is equal to 1 within 600 seconds
